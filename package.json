{
	"name": "decktuner",
	"version": "1.3.1",
	"description": "Plugin that loads ShareDeck & SteamDeckHQ reports for your currently-open game.",
	"type": "module",
	"scripts": {
		"build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && rollup -c",
		"presets:aggregate": "node ./scripts/aggregate-sharedeck.mjs",
		"presets:build": "node ./scripts/generate-presets.mjs",
		"watch": "rollup -c -w",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SteamDeckHomebrew/decky-plugin-template.git"
	},
	"keywords": [
		"decky",
		"plugin",
		"sharedeck",
		"steamdeckhq",
		"performance",
		"battery",
		"settings",
		"steam-deck",
		"deck"
	],
	"author": "DCA <davocarli@gmail.com>",
	"license": "BSD-3-Clause",
	"bugs": {
		"url": "https://github.com/SteamDeckHomebrew/decky-plugin-template/issues"
	},
	"homepage": "https://github.com/SteamDeckHomebrew/decky-plugin-template#readme",
	"devDependencies": {
		"@decky/rollup": "^1.0.2",
		"@decky/ui": "^4.11.0",
		"@types/react": "19.1.1",
		"@types/react-dom": "19.1.1",
		"@types/webpack": "^5.28.0",
		"rollup": "^4.53.3",
		"typescript": "^5.6.2"
	},
	"dependencies": {
		"@decky/api": "^1.1.3",
		"react-icons": "^5.3.0",
		"tslib": "^2.7.0"
	},
	"engines": {
		"node": ">=18 <21"
	},
	"pnpm": {
		"peerDependencyRules": {
			"ignoreMissing": [
				"react",
				"react-dom"
			]
		}
	}
}
